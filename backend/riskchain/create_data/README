To Create data type following into terminal:

# Create Citys and Countries
python manage.py shell < create_data/create_locations.py
# Create Nodes
python manage.py shell < create_data/create_nodes.py
# Create SupplyChains, ChainSteps and Edges
python manage.py shell -c "from create_data.create_supplychains import generate_supplychains; print('Created', generate_supplychains(count=5000, min_len=4, max_len=7, seed=42), 'chains')"

# Create all supply durations
python manage.py shell < create_data/calculate_supply_duration.py